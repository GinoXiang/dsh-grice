{
  "name": "dsh-grice",
  "version": "0.2.0",
  "description": "格赖斯模式：输入框里两个分体控件（沟通基调、产出形态各带独立开关与预设下拉），按会话注入系统提示词；附带预设管理设置页。Two split composer controls (tone and output form, each with its own switch and preset menu) that steer each session's system prompt, with a preset settings page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "grice",
    "pragmatics",
    "communication",
    "格赖斯",
    "高效沟通"
  ],
  "author": "GinoXiang (https://github.com/GinoXiang)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GinoXiang/dsh-grice.git"
  },
  "homepage": "https://github.com/GinoXiang/dsh-grice#readme",
  "bugs": {
    "url": "https://github.com/GinoXiang/dsh-grice/issues"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
