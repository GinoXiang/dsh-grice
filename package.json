{
  "name": "dsh-output-style",
  "version": "0.4.0",
  "description": "输出风格：输入框里两个分体控件（沟通基调、产出形态各带独立开关与预设菜单），按会话注入系统提示词；附带预设管理设置页。Two split composer controls for output style (tone and output form, each with its own switch and preset menu) that steer each session's system prompt, with a preset settings page.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "output-style",
    "tone",
    "grice",
    "presets",
    "communication",
    "输出风格",
    "沟通基调"
  ],
  "author": "GinoXiang (https://github.com/GinoXiang)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GinoXiang/dsh-output-style.git"
  },
  "homepage": "https://github.com/GinoXiang/dsh-output-style#readme",
  "bugs": {
    "url": "https://github.com/GinoXiang/dsh-output-style/issues"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
